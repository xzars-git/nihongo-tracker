#!/bin/sh
# Re-stamp asset versions (cache busting) and run the static checks before every commit.
# Enable once per clone:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
command -v python >/dev/null 2>&1 || exit 0
python -I scripts/stamp.py >/dev/null && git add index.html about.html metode.html && python -I scripts/check.py
