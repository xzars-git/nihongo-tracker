{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/home", "permanent": false },
    { "source": "/index", "destination": "/home", "permanent": false },
    { "source": "/index.html", "destination": "/home", "permanent": false }
  ],
  "rewrites": [{ "source": "/home", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
